import { getServiceSettings } from "@/lib/elsa-storage";
import type { AixiSelfReport, DocumentProductionReport, ExchangeBalance, ExchangeStatus, NativeHealth, PerpetualBrainStatus, PerpetualStrategyStatus, PerpetualTask, Plugin, ProactiveEventFeed, ServiceMemoryRecent, ServiceMemoryStats, ServiceModelConfig, ServiceModels, SystemCapabilityInventory, SystemResources, SystemStorageInventory, TradeAutoStatus, TradePositions } from "@/lib/elsa-types";
import { parseDocumentProductionReport } from "@/lib/document-contracts";
import { parseSystemCapabilityInventory, parseSystemStorageInventory } from "@/lib/inventory-contracts";
import { parsePerpetualBrainStatus } from "@/lib/perpetual-brain";
import { parseAixiSelfReport, parsePerpetualStrategyStatus, parsePerpetualTask, parsePerpetualTasks } from "@/lib/perpetual-contracts";
import { parseProactiveEventFeed } from "@/lib/proactive-contracts";
import { parseSystemResources } from "@/lib/system-resources";
import { buildAixiAskRequest, parseAixiChatReply, type AixiChatReply } from "./chat-contracts";

export { parsePerpetualBrainStatus } from "@/lib/perpetual-brain";
export { buildAixiAskRequest, parseAixiChatReply } from "./chat-contracts";
export type { AixiChatReply, AixiVoiceDirective } from "./chat-contracts";

export class ElsaApiError extends Error {
  constructor(message: string) {
    super(message);
    this.name = "ElsaApiError";
  }
}

export interface CreatePerpetualTaskRequest {
  kind: "code" | "research" | "maintenance";
  title: string;
  objective: string;
}

export function normalizeServiceUrl(input: string): string {
  return input.trim().replace(/\/+$/, "");
}

export function validateServiceUrl(input: string): string | null {
  if (!input) return "請輸入服務位址。";
  try {
    const url = new URL(input);
    if (url.protocol !== "https:" && url.protocol !== "http:") {
      return "服務位址必須以 http:// 或 https:// 開頭。";
    }
    return null;
  } catch {
    return "服務位址格式不正確。";
  }
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return Boolean(value) && typeof value === "object" && !Array.isArray(value);
}

async function request<T>(path: string, init?: RequestInit): Promise<T> {
  const settings = await getServiceSettings();
  const baseUrl = normalizeServiceUrl(settings.baseUrl);
  if (!baseUrl) throw new ElsaApiError("尚未設定服務位址。請先到設定頁連線。");

  let response: Response;
  try {
    response = await fetch(`${baseUrl}${path}`, {
      ...init,
      headers: {
        Accept: "application/json",
        ...(init?.body ? { "Content-Type": "application/json" } : {}),
        ...(init?.headers ?? {}),
      },
    });
  } catch {
    throw new ElsaApiError("無法連線到服務。請確認位址、網路與服務狀態。");
  }

  const body = await response.text();
  let payload: unknown = null;
  try {
    payload = body ? JSON.parse(body) : null;
  } catch {
    throw new ElsaApiError("服務回傳的格式無法辨識。請確認服務位址。 ");
  }

  if (!response.ok) {
    const detail = typeof payload === "object" && payload && "error" in payload
      ? String((payload as { error?: string }).error)
      : `服務回應 ${response.status}`;
    throw new ElsaApiError(detail);
  }
  return payload as T;
}

export async function listPlugins(): Promise<Plugin[]> {
  const response = await request<{ plugins: Plugin[] }>("/api/plugins");
  return response.plugins;
}

export function getExchanges(): Promise<ExchangeStatus> {
  return request("/api/exchanges");
}

export function getNativeHealth(): Promise<NativeHealth> {
  return request("/health");
}

export function getExchangeBalance(): Promise<ExchangeBalance> {
  return request("/trade/balance");
}

export function getTradePositions(): Promise<TradePositions> {
  return request("/trade/positions");
}

export function getServiceMemoryStats(): Promise<ServiceMemoryStats> {
  return request("/api/memory/stats");
}

export function getRecentServiceMemories(): Promise<ServiceMemoryRecent> {
  return request("/api/memory/recent");
}

export function getTradeAutoStatus(): Promise<TradeAutoStatus> {
  return request("/trade/auto/status");
}

/**
 * This endpoint is intentionally optional. A missing or malformed endpoint is
 * rendered as “未回報”, not inferred from `/ask` or trading activity.
 */
export async function getPerpetualBrainStatus(): Promise<PerpetualBrainStatus> {
  return parsePerpetualBrainStatus(await request<unknown>("/api/perpetual/status"));
}

/** Reads only the explicit telemetry emitted by the N1 resource route. */
export async function getSystemResources(): Promise<SystemResources> {
  return parseSystemResources(await request<unknown>("/api/system/resources"));
}

/** Reads only the sanitized, explicit three-node storage report produced by N1. */
export async function getSystemStorageInventory(): Promise<SystemStorageInventory> {
  return parseSystemStorageInventory(await request<unknown>("/api/system/storage-inventory"));
}

/** Reads aggregate capability candidates only; it never exposes paths, content or secrets. */
export async function getSystemCapabilityInventory(): Promise<SystemCapabilityInventory> {
  return parseSystemCapabilityInventory(await request<unknown>("/api/system/capability-inventory"));
}

/** Reads the N1 task queue; task execution is never inferred from chat replies. */
export async function getPerpetualTasks(): Promise<PerpetualTask[]> {
  return parsePerpetualTasks(await request<unknown>("/api/perpetual/tasks"));
}

/** Creates a task only. Queued state is never shown as execution evidence. */
export async function createPerpetualTask(input: CreatePerpetualTaskRequest): Promise<PerpetualTask> {
  const payload = await request<unknown>("/api/perpetual/tasks", {
    method: "POST",
    body: JSON.stringify(input),
  });
  const taskPayload = isRecord(payload) && "task" in payload ? payload.task : payload;
  return parsePerpetualTask(taskPayload);
}

/** Reads the explicitly reported strategy lifecycle and risk guard state. */
export async function getPerpetualStrategyStatus(): Promise<PerpetualStrategyStatus> {
  return parsePerpetualStrategyStatus(await request<unknown>("/api/perpetual/strategy-status"));
}

/**
 * Optional future self-report. A missing route stays unreported in the UI and
 * must not be synthesized from `/ask` or background task messages.
 */
export async function getAixiSelfReport(): Promise<AixiSelfReport> {
  return parseAixiSelfReport(await request<unknown>("/api/ai/self-status"));
}

/** Reads only explicit N1 worker events; chat replies are never proactive events. */
export async function getProactiveEvents(): Promise<ProactiveEventFeed> {
  return parseProactiveEventFeed(await request<unknown>("/api/perpetual/events"));
}

/** Reads only explicit N1 document-artifact reports; a queued request is not an artifact. */
export async function getDocumentProductionReport(): Promise<DocumentProductionReport> {
  return parseDocumentProductionReport(await request<unknown>("/api/documents/report"));
}

export function getServiceModelConfig(): Promise<ServiceModelConfig> {
  return request("/api/config");
}

export function getServiceModels(): Promise<ServiceModels> {
  return request("/api/models");
}

export async function askElsa(message: string): Promise<AixiChatReply> {
  const response = await request<unknown>("/ask", {
    method: "POST",
    body: JSON.stringify(buildAixiAskRequest(message)),
  });
  return parseAixiChatReply(response);
}

export function errorMessage(error: unknown): string {
  return error instanceof Error ? error.message : "發生未預期的錯誤。";
}
